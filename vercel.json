{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "livora-campus-living": {
      "root": "client",
      "framework": "vite"
    },
    "livora-hostel-api": {
      "root": "server",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "livora-hostel-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "livora-campus-living"
      }
    }
  ]
}
